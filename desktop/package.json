{
  "name": "@photosync/desktop",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "main": "dist-electron/entry.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:dev": "wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "test": "tsc -p tsconfig.electron-test.json && tsc -p tsconfig.renderer-test.json && node --test dist-electron-test/*.test.js dist-renderer-test/*.test.js",
    "smoke:packaged-renderer": "electron . --no-sandbox",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@photosync/core": "*",
    "@photosync/google-drive": "*",
    "@photosync/google-photos": "*",
    "@photox/auth-jose": "*",
    "@photox/media-api": "*",
    "@photox/persistence-sqlite": "*",
    "@photox/video-ffmpeg": "*",
    "@photox/video-media": "*",
    "dotenv": "^17.2.2",
    "exifr": "^7.1.3",
    "google-auth-library": "^10.3.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "electron": "44.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.aiautotool.photosync.desktop",
    "productName": "PhotoSync",
    "electronVersion": "44.0.0",
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "google-oauth.json",
        "to": "google-oauth.json"
      },
      {
        "from": "bin/cloudflared-darwin-arm64",
        "to": "cloudflared"
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "dmg": {
      "title": "PhotoSync ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
