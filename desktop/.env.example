# Internet reverse tunnel relay. Production should be HTTPS, for example:
# https://relay.photosync.yourdomain.com
PHOTOSYNC_RELAY_URL=http://127.0.0.1:8787

# Google Cloud Console -> OAuth 2.0 Client IDs -> Desktop app
PHOTOSYNC_GOOGLE_DESKTOP_CLIENT_ID=123456789-desktop.apps.googleusercontent.com
PHOTOSYNC_GOOGLE_DESKTOP_CLIENT_SECRET=GOCSPX-example

# Web edge (same React UI as Desktop)
PHOTOX_WEB_ENABLED=false
PHOTOX_WEB_HOST=127.0.0.1
PHOTOX_WEB_PORT=43118
PHOTOX_WEB_PUBLIC_BASE_URL=https://photos.example.com
PHOTOX_WEB_ALLOWED_ORIGINS=https://photos.example.com
PHOTOX_WEB_RATE_LIMIT=300

# Billing provider webhook. Configure the Stripe endpoint to POST to:
# https://photos.example.com/api/web/v1/billing/webhooks/stripe
# Use the endpoint-specific whsec_... value. Never expose it to renderer/mobile code.
PHOTOX_STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe control-plane API credential. Server/Electron main process only; never expose this
# secret or price mapping to renderer, Web browser code, or Mobile.
PHOTOX_STRIPE_SECRET_KEY=sk_live_replace_me
# Map PhotoX plans to authoritative Stripe Price IDs. Configure only plans sold by this workspace deployment.
# Free may be left empty when free is implemented as an end-of-period local entitlement target rather than a Stripe price.
PHOTOX_STRIPE_PRICE_FREE=
PHOTOX_STRIPE_PRICE_PERSONAL=price_replace_personal
PHOTOX_STRIPE_PRICE_PRO=price_replace_pro
PHOTOX_STRIPE_PRICE_FAMILY=price_replace_family
PHOTOX_STRIPE_PRICE_TEAM=price_replace_team

# Periodically read the authoritative Stripe subscription to heal missed/delayed webhook delivery.
# Default: 900000 (15 minutes). Runtime clamps the interval to 1 minute .. 24 hours.
# The worker is disabled when PHOTOX_STRIPE_SECRET_KEY is empty.
PHOTOX_BILLING_RECONCILIATION_INTERVAL_MS=900000

# Entitlement plan applied by the restart-safe period-end maintenance worker after a
# subscription has reached a provider-confirmed canceled period end.
PHOTOX_BILLING_PERIOD_END_TARGET_PLAN=free
