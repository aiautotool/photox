{
  "expo": {
    "name": "PhotoSync",
    "slug": "photosync",
    "scheme": "photosync",
    "version": "0.6.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "PhotoSync cần đọc ảnh và video để đồng bộ sang laptop.",
          "savePhotosPermission": "PhotoSync cần quyền lưu ảnh và video đã tải xuống vào thư viện."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép PhotoSync dùng camera để quét QR ghép nối với laptop."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-background-task",
      "expo-image",
      "expo-status-bar"
    ],
    "ios": {
      "bundleIdentifier": "com.aiautotool.photosync",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PhotoSync cần kết nối tới laptop trong cùng mạng Wi-Fi để đồng bộ ảnh.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "PhotoSync dùng camera để quét QR ghép nối với laptop.",
        "NSPhotoLibraryUsageDescription": "PhotoSync cần đọc ảnh và video để đồng bộ sang laptop của bạn.",
        "UIBackgroundModes": [
          "processing",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.aiautotool.photosync",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF2FF"
      }
    }
  }
}
